# Port where the server listens for HTTP requests
PORT=3000

# Maximum number of profiles that can be saved -!EDIT!-
MAX_PROFILES=4

# Configuration of the MongoDB (equal to MONGO_INITDB_ROOT_USERNAME and MONGO_INITDB_ROOT_PASSWORD)
MONGO_USER=your_username
MONGO_PASSWORD=your_password
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
DB_NAME=user-account